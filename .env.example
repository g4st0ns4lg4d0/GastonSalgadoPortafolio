# Desarrollo local. Copiar a .env; no incorporar .env al repositorio.
DJANGO_SETTINGS_MODULE=config.settings.development

# Exclusivo para desarrollo. Generar una clave propia para producción.
DJANGO_SECRET_KEY=development-only-replace-this-key-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

# Omitir para usar SQLite: var/db.sqlite3. Producción requiere PostgreSQL.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/portfolio

# Opcionales: usar rutas absolutas para almacenamiento persistente.
# PRIVATE_MEDIA_ROOT=/ruta/absoluta/archivos-privados
# STATIC_ROOT=/ruta/absoluta/staticfiles
# Solo producción detrás de un proxy confiable que sobrescribe cabeceras:
# DJANGO_TRUST_PROXY=True

# Producción: config.settings.production, clave propia, hosts exactos,
# orígenes HTTPS, SITE_URL HTTPS y DATABASE_URL por un canal seguro.
